{
  "manifest_version": 3,
  "name": "Crunchyroll+",
  "short_name": "CR+",
  "version": "0.7.0",
  "description": "__MSG_description__",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://www.crunchyroll.com/*",
    "https://myanimelist.net/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Crunchyroll+",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "src/bg.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.crunchyroll.com/*"
      ],
      "js": [
        "src/hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.crunchyroll.com/*"
      ],
      "css": [
        "src/boot.css"
      ],
      "js": [
        "src/core/util.js",
        "src/core/i18n.js",
        "src/i18n/en.js",
        "src/i18n/es-419.js",
        "src/i18n/it.js",
        "src/i18n/de.js",
        "src/i18n/fr.js",
        "src/core/diag.js",
        "src/core/model.js",
        "src/core/store.js",
        "src/core/api.js",
        "src/core/external.js",
        "src/core/filler.js",
        "src/core/tags.js",
        "src/core/catalog.js",
        "src/core/query.js",
        "src/core/finder.js",
        "src/core/profile.js",
        "src/core/recs.js",
        "src/core/agenda.js",
        "src/ui/components.js",
        "src/ui/drawer.js",
        "src/ui/views/today.js",
        "src/ui/views/search.js",
        "src/ui/views/foryou.js",
        "src/ui/views/agenda.js",
        "src/ui/app.js",
        "src/main.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/ui/app.css"
      ],
      "matches": [
        "https://www.crunchyroll.com/*"
      ]
    }
  ],
  "default_locale": "es"
}
